# ─────────────────────────────────────────────────────────────
# SyncDBAndMonday — environment configuration
# Copy relevant values into .env.local (gitignored). Never commit secrets.
# ─────────────────────────────────────────────────────────────

# === DEV / TEST environment ===
# Supabase dev project (control-plane rows use environment = 'test')
PUBLIC_SUPABASE_URL=https://YOUR_DEV_REF.supabase.co
PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxx          # optional, not used by the engine
SUPABASE_DEV_SECRET=sb_secret_xxx                    # required: secret/service key for schema + read/write
MONDAY_DEV_API=eyJ...                                # required: Monday personal token for the DEV account (bist3)

# === PRODUCTION environment (fill in when going live) ===
SUPABASE_PROD_URL=https://YOUR_PROD_REF.supabase.co
SUPABASE_PROD_SECRET=sb_secret_xxx
MONDAY_PROD_API=eyJ...                                # Monday token for PROD account (bist-cast)

# === Server ===
PORT=4000

# === Auth (REQUIRED on Railway / any public deploy) ===
# n8n must send this as header  x-api-key: <value>   (or Authorization: Bearer <value>).
# If unset, the API is OPEN — fine for localhost, never for a public host.
# On Railway: set these as service Variables (there is no .env.local in the cloud).
SYNC_API_KEY=change-me-to-a-long-random-string
